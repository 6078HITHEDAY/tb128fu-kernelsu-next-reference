+/*
+ * Raw-register variant for the syscall-table hook: it sees the userspace
+ * filename/argv directly, before the original execve is called.  Handles the
+ * two integration points that the kprobe scheme gets from ksu_handle_execveat_ksud:
+ * init second_stage (SELinux rules/creds) and the first zygote exec (post-fs-data).
+ */
+void ksu_handle_execve_raw(const char __user *filename_user,
+			   const char __user *const __user *argv_user);
+
 void ksu_ksud_init();
 void ksu_ksud_exit();
 
