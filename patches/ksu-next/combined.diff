index f3295f47..4a5e51fb 100644
--- a/kernel/runtime/ksud_integration.c
+++ b/kernel/runtime/ksud_integration.c
@@ -268,14 +268,104 @@ static bool check_argv(struct user_arg_ptr argv, int index,
 
 static void ksu_initialize_selinux_tw_func(struct callback_head *cb)
 {
+	ksu_debug_log("selinux: second_stage task_work running");
 	ksu_selinux_hide_handle_second_stage();
 	apply_kernelsu_rules();
 	ksu_feature_apply_forced();
 	cache_sid();
 	setup_ksu_cred();
+	ksu_debug_log("selinux: rules/creds applied");
 	kfree(cb);
 }
 
+static bool check_argv_raw(const char __user *const __user *argv, int index,
+			   const char *expected)
+{
+	const char __user *p;
+	char buf[32];
+
+	if (!argv || get_user(p, argv + index) || !p)
+		return false;
+
+	if (strncpy_from_user_nofault(buf, p, sizeof(buf)) <= 0)
+		return false;
+
+	buf[sizeof(buf) - 1] = '\0';
+	return !strcmp(buf, expected);
+}
+
+/*
+ * Called from the syscall-table execve/execveat wrappers.  The kprobe-based
+ * integration reaches ksu_handle_execveat_ksud() through an execve probe, but
+ * the table hook has no such probe, so these two hooks were never fired:
+ *
+ *  - /system/bin/init second_stage: apply the KSU SELinux rules and cache the
+ *    init SID; without this the ksu domain/creds never exist.
+ *  - first exec of /system/bin/app_process -Xzygote: schedule
+ *    on_post_fs_data() (allowlist load + fsnotify observer).  Without the
+ *    observer, packages.list changes are never seen, the manager is never
+ *    crowned, and it cannot obtain the [ksu_driver] fd.
+ */
+void ksu_handle_execve_raw(const char __user *filename_user,
+			   const char __user *const __user *argv_user)
+{
+	static const char app_process[] = "/system/bin/app_process";
+	static const char system_bin_init[] = "/system/bin/init";
+	static bool first_zygote = true;
+	static bool init_second_stage_executed = false;
+	char path[64];
+
+	if (!filename_user || !argv_user)
+		return;
+
+	if (strncpy_from_user_nofault(path, filename_user, sizeof(path)) < 0)
+		return;
+
+	if (!strncmp(path, system_bin_init, sizeof(system_bin_init) - 1)) {
+		if (!init_second_stage_executed) {
+			int m = check_argv_raw(argv_user, 1, "second_stage");
+
+			ksu_debug_log("raw: init exec argv1_second_stage=%d", m);
+		}
+		if (!init_second_stage_executed &&
+		    check_argv_raw(argv_user, 1, "second_stage")) {
+			struct callback_head *cb = kzalloc(sizeof(*cb), GFP_ATOMIC);
+
+			pr_info("/system/bin/init second_stage executed\n");
+			if (cb) {
+				cb->func = ksu_initialize_selinux_tw_func;
+				if (task_work_add(current, cb, TWA_RESUME)) {
+					kfree(cb);
+					pr_warn("ksu_initialize_selinux failed to add task work\n");
+				}
+			} else {
+				pr_warn("ksu_initialize_selinux failed to allocate task work\n");
+			}
+			init_second_stage_executed = true;
+		}
+	} else if (first_zygote &&
+		   !strncmp(path, app_process, sizeof(app_process) - 1)) {
+		int m = check_argv_raw(argv_user, 1, "-Xzygote");
+
+		ksu_debug_log("raw: app_process exec path=%s argv1_zygote=%d",
+			      path, m);
+		if (m) {
+			pr_info("exec zygote, /data prepared, second_stage: %d\n",
+				init_second_stage_executed);
+			rcu_read_lock();
+			struct task_struct *init_task =
+				rcu_dereference(current->real_parent);
+			if (init_task)
+				task_work_add(init_task, &on_post_fs_data_cb,
+					      TWA_RESUME);
+			rcu_read_unlock();
+			ksu_debug_log("raw: post_fs_data scheduled");
+			first_zygote = false;
+			stop_execve_hook();
+		}
+	}
+}
+
 // IMPORTANT NOTE: the call from execve_handler_pre WON'T provided correct value for envp and flags in GKI version
 int ksu_handle_execveat_ksud(int *fd, struct filename **filename_ptr,
 				struct user_arg_ptr *argv,
