+/*
+ * Small always-on diagnostic ring used to bring up hook modes on devices
+ * where dmesg is not reachable from adb.  Read it at /proc/ksu_debug.
+ */
+static char ksu_debug_buf[8192];
+static size_t ksu_debug_len;
+static DEFINE_SPINLOCK(ksu_debug_lock);
+
+void ksu_debug_log(const char *fmt, ...)
+{
+	unsigned long flags;
+	va_list args;
+	char line[512];
+	size_t len, drop;
+
+	va_start(args, fmt);
+	len = vscnprintf(line, sizeof(line) - 1, fmt, args);
+	va_end(args);
+	line[len++] = '\n';
+
+	spin_lock_irqsave(&ksu_debug_lock, flags);
+	/* Keep complete recent lines: boot exec traffic must not fill the log. */
+	while (ksu_debug_len + len >= sizeof(ksu_debug_buf)) {
+		char *newline = memchr(ksu_debug_buf, '\n', ksu_debug_len);
+
+		drop = newline ? newline - ksu_debug_buf + 1 : ksu_debug_len;
+		memmove(ksu_debug_buf, ksu_debug_buf + drop, ksu_debug_len - drop);
+		ksu_debug_len -= drop;
+	}
+	memcpy(ksu_debug_buf + ksu_debug_len, line, len);
+	ksu_debug_len += len;
+	ksu_debug_buf[ksu_debug_len] = '\0';
+	spin_unlock_irqrestore(&ksu_debug_lock, flags);
+}
+
+static int ksu_debug_show(struct seq_file *m, void *v)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&ksu_debug_lock, flags);
+	seq_write(m, ksu_debug_buf, ksu_debug_len);
+	spin_unlock_irqrestore(&ksu_debug_lock, flags);
+	return 0;
+}
+
+static int ksu_debug_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ksu_debug_show, NULL);
+}
+
+static const struct file_operations ksu_debug_fops = {
+	.open = ksu_debug_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
 #ifdef CONFIG_KSU_DEBUG
 bool allow_shell = true;
 #else
@@ -134,6 +198,10 @@ int __init kernelsu_init(void)
         return -ENOSYS;
     }
 
+#ifdef CONFIG_KSU_SUSFS
+	susfs_init();
+#endif
+
 	ksu_feature_init();
 
 	ksu_sulog_init();
@@ -195,6 +263,16 @@ int __init kernelsu_init(void)
 		ksu_file_wrapper_init();
 	}
 
+	proc_create("ksu_debug", 0444, NULL, &ksu_debug_fops);
+	ksu_debug_log("init: version=%d late=%d builtin=%d",
+		      KERNEL_SU_VERSION, ksu_late_loaded,
+#ifdef MODULE
+		      0
+#else
+		      1
+#endif
+	);
